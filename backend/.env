DATABASE_URL=sqlite:///./database.db
API_PREFIX=/api
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Replace with your free Groq API key (starts with gsk_...) from https://console.groq.com/keys
# Or your OpenAI key (sk-...), or OpenRouter key (sk-or-...)
OPENAI_API_KEY=your_api_key_here

# Optional overrides (automatically detected from key prefix if left empty):
# Groq: LLM_MODEL=llama-3.3-70b-versatile, LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenAI: LLM_MODEL=gpt-4o-mini
LLM_MODEL=
LLM_BASE_URL=
